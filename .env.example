# the queen: deployer of the Hive, the only address that can feed/spawn. Never printed.
SWARM_QUEEN_SECRET=
# from contracts/scripts/deploy.js -> build/hive.json
SWARM_HIVE=
SWARM_TOKEN=
SWARM_CURVE=
SWARM_RPC=https://rpc.mainnet.chain.robinhood.com
# the ONLY thing that arms real transactions
SWARM_LIVE=0
SWARM_TAX_BPS=300
# ETH you seeded the hive with by hand (counts as income for the 10% burn budget)
SWARM_SEED_ETH=0
# optional overrides
SWARM_TICK_S=600
SWARM_MAX_FLIES=64
# public livestream (flybrain relay, new pm2 instance on a new port)
SWARM_RELAY_PUSH=
SWARM_RELAY_SECRET=
# where flycoin lives (graph.npz + flysim)
SWARM_FLYCOIN_DIR=../flycoin
